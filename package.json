{
  "name": "cassago",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "test": "vitest run --config vitest.release.config.ts",
    "test:primer": "vitest run --config vitest.primer.config.ts",
    "test:all": "vitest run",
    "build:pages": "ng build --configuration production --base-href /CasSago/",
    "test:engine-completion": "vitest run tests/core/sanger-short-flank-admission.spec.ts tests/core/sanger-regional-calibration-budget.spec.ts tests/core/sanger-decomposition-completion.spec.ts --maxWorkers=1",
    "test:engine-calibration": "vitest run tests/core/sanger-control-dye-identification.spec.ts tests/core/sanger-reference-novel-response.spec.ts tests/core/sanger-reference-photon-integration.spec.ts --maxWorkers=1"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@types/file-saver": "^2.0.7",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
